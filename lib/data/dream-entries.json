 {
  "chapter": "龍蛇章",
  "text": "夢見蛇咬人家者，母衰。"
 },
 {
  "chapter": "龍蛇章",
  "text": "夢見蛇作盤者，宅不安。"
 },
 {
  "chapter": "龍蛇章",
  "text": "夢見打殺蛇者，大吉。"
 },
 {
  "chapter": "龍蛇章",
  "text": "夢見雜死鳥，遠信至。"
 },
 {
  "chapter": "龍蛇章",
  "text": "夢見飛入鳥屋，兇死。"
 },
 {
  "chapter": "龍蛇章",
  "text": "夢見飛鳥自死，行人病。"
 },
 {
  "chapter": "龍蛇章",
  "text": "夢見白蟲自滅，小口衰。"
 },
 {
  "chapter": "龍蛇章",
  "text": "夢見蛇叫者，大吉利。"
 },
 {
  "chapter": "龍蛇章",
  "text": "夢見蜘蛛達蟲子，口舌。"
 },
 {
  "chapter": "龍蛇章",
  "text": "夢見龜者，口舌。"
 },
 {
  "chapter": "龍蛇章",
  "text": "夢見鱉者，主百吉。"
 },
 {
  "chapter": "龍蛇章",
  "text": "夢見魚者，盡不祥。"
 },
 {
  "chapter": "刀劍弓弩章",
  "text": "夢見被刀傷者，失財。"
 },
 {
  "chapter": "刀劍弓弩章",
  "text": "夢見刀自刺，得財。"
 },
 {
  "chapter": "刀劍弓弩章",
  "text": "夢見磨刀者，有大利。"
 },
 {
  "chapter": "刀劍弓弩章",
  "text": "夢見把刀行者，口舌散。"
 },
 {
  "chapter": "刀劍弓弩章",
  "text": "夢見與人刀劍，失利。"
 },
 {
  "chapter": "刀劍弓弩章",
  "text": "夢見刀相砍者，親事。"
 },
 {
  "chapter": "刀劍弓弩章",
  "text": "夢見被刀殺，得長命。"
 },
 {
  "chapter": "刀劍弓弩章",
  "text": "夢見把刀箭行，身貴。"
 },
 {
  "chapter": "刀劍弓弩章",
  "text": "夢見弓弦，斷事不能。"
 },
 {
  "chapter": "刀劍弓弩章",
  "text": "夢見被射，得人力。"
 },
 {
  "chapter": "刀劍弓弩章",
  "text": "夢見劍行者，大富。"
 },
 {
  "chapter": "刀劍弓弩章",
  "text": "夢見軍陣者，遠行。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見妻喜，得人財物。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見妻打身，得妻力。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見打妻者，主失財。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見遣妻者，得外財。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見夫妻相拜，主離。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見夫妻執手，大吉。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見妻濃妝，必分。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見娶妻，主改動。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見妻有娠，大凶。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見妻病，有失財。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見妻者，得大財。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見妻帶刀，主子重見。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見門開，妻有外宿。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見與女子交，夫兇。"
 },
 {
  "chapter": "夫妻花粉章",
  "text": "夢見花釵妝粉，口舌。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見宮市樓店，大吉。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見牽影，主官祿。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見上樓閣者，得官。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見起造房屋，主昌。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見上屋，憂火燭。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見金銀者，有論訟。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見穿錢者，主口舌。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見將錢與人者，主大吉利。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見錢破者，口舌散。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見拾得財物，失財。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見維傢俱，宅不安。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見薦席者，憂病身。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見錦繡，憂官事。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見綾綃者，主大吉。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見絲綿者，主長命。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見秤鬥升尺，得財。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見紙筆者，訴訟。"
 },
 {
  "chapter": "樓閣家具錢帛章",
  "text": "夢見大書者，有喜慶。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見落舡中者，大吉。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見舡沆者，憂身亡。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見舡滿者，大疾病。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見舡中行者，大利。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見帆慢使風少，吉。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見棄車行，主得官。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見車無輪，福敗。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見上橋者，主長命。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見橋樑折者，大凶。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見橋上叫嚷，大凶。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見從險道行者，吉。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見路上屎尿，大財得。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見市中行者，大吉。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見米麵，憂身病。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見粟穀者，主長命。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見麻豆麥者，（得）酒食。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見登山壟者，主高貴。"
 },
 {
  "chapter": "舟車橋市谷物章",
  "text": "夢見從高墮地，大凶。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見病人行者，憂兇。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見病人者，吉利。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見唱歌，大憂。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見病人沐浴者，兇。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見病人吃飯食者，兇。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見病人吐者，吉慶。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見病人落地者，兇。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見病人下舡者，大吉。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見病止，喪父母，家寧。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見死人卻活，主貴。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見有死亡，憂子孫。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見與死人同食，吉。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見茅孝者，大吉利。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見哭泣，大吉利。"
 },
 {
  "chapter": "生死疾病章",
  "text": "夢見鄰舍有疾，吉慶。"
 },
 {
  "chapter": "塚墓棺財兇具章",
  "text": "夢見塚作墓者，大吉。"
 },
 {
  "chapter": "塚墓棺財兇具章",
  "text": "夢見塚上生樹者，大吉。"
 },
 {
  "chapter": "塚墓棺財兇具章",
  "text": "夢見墓林茂盛，家王。"
 },
 {
  "chapter": "塚墓棺財兇具章",
  "text": "夢見塚墓上行，大喜。"
 },
 {
  "chapter": "塚墓棺財兇具章",
  "text": "夢見塚（上）果樹析，有訴。"
 },
 {
  "chapter": "塚墓棺財兇具章",
  "text": "夢見棺出塚外，大吉。"
 },
 {
  "chapter": "塚墓棺財兇具章",
  "text": "夢見棺入宅，財來。"
 },
 {
  "chapter": "塚墓棺財兇具章",
  "text": "夢見棺出宅，失財。"
 },
 {
  "chapter": "塚墓棺財兇具章",
  "text": "夢見棺開張，得大財。"
 },
 {
  "chapter": "塚墓棺財兇具章",
  "text": "夢見棺木關者，兇惡。"
 },
 {
  "chapter": "塚墓棺財兇具章",
  "text": "夢見棺水流，吉。"
 },
 {
  "chapter": "塚墓棺財兇具章",
  "text": "夢見棺中人語，得財。"
 }
]
