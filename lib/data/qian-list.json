[
  {
    "no": 1,
    "grade": "上籤",
    "title": "鍾離成道",
    "poem": [
      "天開地闢結良緣",
      "日吉時良萬事全",
      "若得此籤非小可",
      "人行中正帝王宣"
    ]
  },
  {
    "no": 2,
    "grade": "下籤",
    "title": "蘇秦不第",
    "poem": [
      "鯨魚未化守江湖",
      "未許升騰離碧波",
      "異日崢嶸身變態",
      "從教一躍禹門過"
    ]
  },
  {
    "no": 3,
    "grade": "下籤",
    "title": "董永遇仙（故事與籤詩不合",
    "poem": [
      "衝風冒雨去還歸",
      "役役勞身似燕兒",
      "啣得泥來成疊後",
      "到頭疊壞復成泥"
    ]
  },
  {
    "no": 4,
    "grade": "上籤",
    "title": "玉蓮會十朋",
    "poem": [
      "菱花鏡破復重圓",
      "女再求夫男再婚",
      "自此門閭重改換",
      "更添福祿與兒孫"
    ]
  },
  {
    "no": 5,
    "grade": "中籤",
    "title": "劉晨遇仙",
    "poem": [
      "一鋤掘地要求泉",
      "努力求之得最先",
      "無意俄然遇知己",
      "相逢攜手上青天"
    ]
  },
  {
    "no": 6,
    "grade": "中籤",
    "title": "仁貴遇主",
    "poem": [
      "投身巖下飼於菟",
      "須是還他大丈夫",
      "捨己也應難再得",
      "通行天下此人無"
    ]
  },
  {
    "no": 7,
    "grade": "下籤",
    "title": "蘇娘走難",
    "poem": [
      "奔波役役重重險",
      "帶水拖泥又渡山",
      "更慮他方求別用",
      "千山萬水未能還"
    ]
  },
  {
    "no": 8,
    "grade": "上籤",
    "title": "范文正公斷虀畫粥",
    "poem": [
      "歲寒松柏古栽培",
      "雨雪風霜總不摧",
      "異日必當成大用",
      "功名作個棟樑材"
    ]
  },
  {
    "no": 9,
    "grade": "上籤",
    "title": "孔明點將",
    "poem": [
      "勞君問我心中事",
      "此意偏宜說向公",
      "一片靈臺明似鏡",
      "恰如明月正當空"
    ]
  },
  {
    "no": 10,
    "grade": "中籤",
    "title": "龐涓觀陣",
    "poem": [
      "櫝藏無價寶和珍",
      "只管他鄉外處尋",
      "好似將燈來覔火",
      "不如安靜莫勞心"
    ]
  },
  {
    "no": 11,
    "grade": "上籤",
    "title": "書薦姜維(書獻姜維)",
    "poem": [
      "欲求好事喜非常",
      "爭奈姻親只暫忙",
      "畢竟到頭成好事",
      "貴人接引貴人鄉"
    ]
  },
  {
    "no": 12,
    "grade": "上籤",
    "title": "武吉遇師",
    "poem": [
      "時臨否極泰當來",
      "抖擻從君出暗埃",
      "若遇卯寅佳信至",
      "管教立志事和諧"
    ]
  },
  {
    "no": 13,
    "grade": "中籤",
    "title": "羅通拜帥",
    "poem": [
      "自小生身富貴家",
      "眼前萬事總奢華",
      "要君賜受金魚袋",
      "四海傳名足可誇"
    ]
  },
  {
    "no": 14,
    "grade": "中籤",
    "title": "子牙棄官",
    "poem": [
      "宛如仙鶴出樊籠",
      "脫却羈縻處處通",
      "南北東西無障碍",
      "任君直上九霄中"
    ]
  },
  {
    "no": 15,
    "grade": "中籤",
    "title": "蘇秦得志",
    "poem": [
      "觸人口氣最難吞",
      "忽有災危禍到門",
      "卵破巢空無宿處",
      "深為穩便把心存"
    ]
  },
  {
    "no": 16,
    "grade": "中籤",
    "title": "葉夢熊朝帝",
    "poem": [
      "攢眉思慮暫時開",
      "咫尺雲開見日來",
      "宛似汙泥中片玉",
      "良工一舉出塵埃"
    ]
  },
  {
    "no": 17,
    "grade": "中籤",
    "title": "曹操話梅止渴",
    "poem": [
      "莫聽閑言與是非",
      "晨昏只好念阿彌",
      "若將妄語為真實",
      "畫餅如何療得飢"
    ]
  },
  {
    "no": 18,
    "grade": "上籤",
    "title": "曹國舅為仙",
    "poem": [
      "金烏西墜兔東臨",
      "日夜循環亘古今",
      "僧道得之無不利",
      "工商農士各開心"
    ]
  },
  {
    "no": 19,
    "grade": "中籤",
    "title": "子儀封王（籤詩與故事不合）",
    "poem": [
      "急水灘頭放艇時",
      "狂風作浪欲何為",
      "待他浪靜風停後",
      "穩載船歸過不危"
    ]
  },
  {
    "no": 20,
    "grade": "中籤",
    "title": "姜太公遇文王",
    "poem": [
      "當春久雨喜初晴",
      "玉兔金烏漸漸明",
      "舊事已成新事遂",
      "看看一跳入蓬瀛"
    ]
  },
  {
    "no": 21,
    "grade": "上籤",
    "title": "李旦龍鳳配合",
    "poem": [
      "陰陽道合總由天",
      "女嫁男婚豈偶然",
      "但看龍蛇堪運動",
      "熊羆叶夢喜團圓"
    ]
  },
  {
    "no": 22,
    "grade": "上籤",
    "title": "六郎逢救",
    "poem": [
      "四郊田畝皆枯竭",
      "久旱俄然三日霖",
      "花菓草芽俱潤澤",
      "始知一雨值千金"
    ]
  },
  {
    "no": 23,
    "grade": "中籤",
    "title": "懷德招親",
    "poem": [
      "欲攀仙桂蟾宮去",
      "豈慮天門不放開",
      "謀望一般音信好",
      "高人自送嶺頭來"
    ]
  },
  {
    "no": 24,
    "grade": "下籤",
    "title": "殷郊遇師",
    "poem": [
      "不成鄰里不成家",
      "水泡痴人似落花",
      "若問君恩難得力",
      "到頭畢竟事如蔴"
    ]
  },
  {
    "no": 25,
    "grade": "中籤",
    "title": "姚能受職（本籤多不採用此故事",
    "poem": [
      "過了憂危第幾重",
      "從今再歷永無凶",
      "寬心自有寬心計",
      "得遇高人護聖功"
    ]
  },
  {
    "no": 26,
    "grade": "中籤",
    "title": "鍾馗得道",
    "poem": [
      "上下傳來事總虛",
      "天邊接得一封書",
      "書中許我功名事",
      "直待終時亦是無"
    ]
  },
  {
    "no": 27,
    "grade": "中籤",
    "title": "劉基諫主",
    "poem": [
      "一謀一用一番機",
      "慮後疑前不敢為",
      "時至自然逢貴助",
      "銀牆鐵壁好安居"
    ]
  },
  {
    "no": 28,
    "grade": "中籤",
    "title": "包公尋李后",
    "poem": [
      "東方月上正蟬娟",
      "頃刻雲遮月半邊",
      "莫道圓時還又缺",
      "須教缺處復重圓"
    ]
  },
  {
    "no": 29,
    "grade": "中籤",
    "title": "趙子龍救阿斗",
    "poem": [
      "寶劍光芒出匣時",
      "匣中應不被塵欺",
      "貴人親手提攜起",
      "儘可防身更勿疑"
    ]
  },
  {
    "no": 30,
    "grade": "中籤",
    "title": "棋盤大會",
    "poem": [
      "勸君切莫向他求",
      "似鶴飛來暗箭投",
      "若去採薪蛇伏草",
      "恐遭毒手也堪憂"
    ]
  },
  {
    "no": 31,
    "grade": "中籤",
    "title": "佛印會東坡",
    "poem": [
      "清閑無事靜處坐",
      "飢時吃飯困時臥",
      "放下身心不用忙",
      "必定不遭殃與禍"
    ]
  },
  {
    "no": 32,
    "grade": "中籤",
    "title": "劉備求賢",
    "poem": [
      "渺渺前途事可疑",
      "石中藏玉有誰知",
      "一朝良臣分明剖",
      "始覺其中碧玉奇"
    ]
  },
  {
    "no": 33,
    "grade": "中籤",
    "title": "咬金聘仁貴",
    "poem": [
      "石藏美玉在中心",
      "得指何須向外尋",
      "直待高人來剖析",
      "恰如靈雨滌煩襟"
    ]
  },
  {
    "no": 34,
    "grade": "中籤",
    "title": "桃園結義",
    "poem": [
      "出入行藏禮義恭",
      "言必忠良聽必聰",
      "心下了然俱洞徹",
      "光明如日正當空"
    ]
  },
  {
    "no": 35,
    "grade": "中籤",
    "title": "唐僧取經",
    "poem": [
      "衣冠重整舊宿風",
      "道是無功卻有功",
      "掃卻當途荊棘碍",
      "三人共議事相同"
    ]
  },
  {
    "no": 36,
    "grade": "中籤",
    "title": "湘子遇寶(賓)",
    "poem": [
      "目前病訟不須憂",
      "實地資財儘可求",
      "恰好繫猿金脫鎖",
      "得歸仙洞去來遊"
    ]
  },
  {
    "no": 37,
    "grade": "中籤",
    "title": "李靖歸山",
    "poem": [
      "欲問身安運泰時",
      "風中燈燭不相宜",
      "爭如收拾深堂坐",
      "庶免光搖靜處期"
    ]
  },
  {
    "no": 38,
    "grade": "下籤",
    "title": "何文秀遇難",
    "poem": [
      "鏡月當空出匣時",
      "剎那雲霧暗迷離",
      "寬心守待浮雲散",
      "更改相宜可望為"
    ]
  },
  {
    "no": 39,
    "grade": "下籤",
    "title": "姜女尋夫",
    "poem": [
      "天邊消息應難問",
      "切莫私心強望求",
      "若把石頭磨作鏡",
      "精神枉費一時休"
    ]
  },
  {
    "no": 40,
    "grade": "中籤",
    "title": "武則天登位",
    "poem": [
      "紅輪西墜兔東升",
      "陰長陽消是兩形",
      "若是女人占此卦",
      "增添福祿稱心情"
    ]
  },
  {
    "no": 41,
    "grade": "中籤",
    "title": "董卓收呂布",
    "poem": [
      "無限好事君須記",
      "恰如認賊作為子",
      "莫貪眼下有些甜",
      "可慮他時還受苦"
    ]
  },
  {
    "no": 42,
    "grade": "上籤",
    "title": "有蓮見母",
    "poem": [
      "君垂恩澤潤無邊",
      "覆禱祈禳沒黨偏",
      "一切有情皆受用",
      "均沾樂利得週全"
    ]
  },
  {
    "no": 43,
    "grade": "上籤",
    "title": "行者得道",
    "poem": [
      "天地交泰萬物新",
      "自形自色自怡神",
      "森羅萬象皆精彩",
      "事事和諧得稱人"
    ]
  },
  {
    "no": 44,
    "grade": "中籤",
    "title": "姜維鄧艾鬥陣",
    "poem": [
      "棋逢對手要藏機",
      "黑白盤中未決時",
      "到底欲知誰勝負",
      "須教先著相機宜"
    ]
  },
  {
    "no": 45,
    "grade": "上籤",
    "title": "仁宗認母",
    "poem": [
      "溫柔自是勝強剛",
      "積善于門太吉昌",
      "若是有人占此卦",
      "宛如止渴遇瓊漿"
    ]
  },
  {
    "no": 46,
    "grade": "中籤",
    "title": "渭水釣魚",
    "poem": [
      "勸君耐守舊生涯",
      "把定身心莫聽邪",
      "直待有人輕著力",
      "滿園枯木再開花"
    ]
  },
  {
    "no": 47,
    "grade": "上籤",
    "title": "梁灝登科",
    "poem": [
      "錦上添花色更鮮",
      "運來祿馬喜雙全",
      "時人莫訝功名晚",
      "一舉登科四海傳"
    ]
  },
  {
    "no": 48,
    "grade": "中籤",
    "title": "韓信掛帥",
    "poem": [
      "鵾鳥秋光化作鵬",
      "遨翔得意盡飛騰",
      "直沖萬里雲霄外",
      "任是諸禽總不能"
    ]
  },
  {
    "no": 49,
    "grade": "中籤",
    "title": "王祥求鯉",
    "poem": [
      "營圖萬事若冰澌",
      "何必慳貪苦所為",
      "只好靜心閑處坐",
      "待他興變復奚疑"
    ]
  },
  {
    "no": 50,
    "grade": "中籤",
    "title": "陶朱歸五湖(范蠡歸湖)",
    "poem": [
      "五湖四海盡行船",
      "高掛風帆把舵堅",
      "幸得順風隨所至",
      "滿船寶貝稱心田"
    ]
  },
  {
    "no": 51,
    "grade": "上籤",
    "title": "孔明入川",
    "poem": [
      "夏日初臨日正常",
      "人皆愁惱熱非常",
      "天公也解諸人意",
      "故遣薰風特送涼"
    ]
  },
  {
    "no": 52,
    "grade": "中籤",
    "title": "太白醉撈明月（李太白醉中捉月）",
    "poem": [
      "水中捉月費工夫",
      "費盡功夫卻又無",
      "莫信閑言併浪論",
      "枉拋心力也難圖"
    ]
  },
  {
    "no": 53,
    "grade": "中籤",
    "title": "劉備招親",
    "poem": [
      "失意翻成得意時",
      "龍吟虎嘯兩相宜",
      "青雲有路終須到",
      "許我功名必可期"
    ]
  },
  {
    "no": 54,
    "grade": "下籤",
    "title": "馬超追曹",
    "poem": [
      "夢中得寶醒來無",
      "應說巫山只是虛",
      "若問婚姻幷病訟",
      "別尋生路得相宜"
    ]
  },
  {
    "no": 55,
    "grade": "中籤",
    "title": "周武王登位",
    "poem": [
      "相傳罔替子孫贊",
      "衣祿豐盈富在天",
      "金馬玉堂人快樂",
      "飢時吃飯困時眠"
    ]
  },
  {
    "no": 56,
    "grade": "中籤",
    "title": "祿山謀反",
    "poem": [
      "澗小石粗流水響",
      "力勞撐駕恐損傷",
      "路須指出前江去",
      "風靜潮平儘不妨"
    ]
  },
  {
    "no": 57,
    "grade": "中籤",
    "title": "董仲尋親",
    "poem": [
      "聞是聞非風過耳",
      "好衣好祿日當空",
      "君須記取他年事",
      "汝意還同我意同"
    ]
  },
  {
    "no": 58,
    "grade": "中籤",
    "title": "文王問卜",
    "poem": [
      "忠言善語君須記",
      "莫向他方求別藝",
      "勸君安守舊生涯",
      "除卻有餘都不是"
    ]
  },
  {
    "no": 59,
    "grade": "中籤",
    "title": "張良隱山",
    "poem": [
      "直上高樓去避身",
      "四邊繞處是荊榛",
      "誰知造物安排定",
      "得意番成失意人"
    ]
  },
  {
    "no": 60,
    "grade": "下籤",
    "title": "赤壁鏖兵",
    "poem": [
      "抱薪救火火增烟",
      "燒卻三千及大千",
      "若問營謀併出入",
      "不如收拾莫憂燃"
    ]
  },
  {
    "no": 61,
    "grade": "中籤",
    "title": "蘇小妹難夫",
    "poem": [
      "日上吟詩月下歌",
      "逢場作戲笑呵呵",
      "相逢會處難藏隱",
      "喝啋齊聲嗹哩囉"
    ]
  },
  {
    "no": 62,
    "grade": "中籤",
    "title": "唐僧得道",
    "poem": [
      "晨昏全賴佛扶持",
      "雖是逢危不見危",
      "若得貴人來接引",
      "此時福祿自相隨"
    ]
  },
  {
    "no": 63,
    "grade": "中籤",
    "title": "黃孝子萬里尋親",
    "poem": [
      "昔日行船失了針",
      "今朝依舊海中尋",
      "若還尋得原針在",
      "也費工夫也費心"
    ]
  },
  {
    "no": 64,
    "grade": "下籤",
    "title": "馬前覆水(覆水難收)",
    "poem": [
      "譬若金鱗放碧漪",
      "暗遭羅網四邊圍",
      "思量無計翻身出",
      "命到泉關苦獨悲"
    ]
  },
  {
    "no": 65,
    "grade": "下籤",
    "title": "孫臏困龐涓",
    "poem": [
      "眼前歡喜未為歡",
      "危不危兮安不安",
      "割肉成瘡因甚事",
      "不如守舊得安全"
    ]
  },
  {
    "no": 66,
    "grade": "下籤",
    "title": "霸王被困。(項羽被困)",
    "poem": [
      "路險馬行人去遠",
      "失群羊困虎相當",
      "危灘船過風翻浪",
      "春暮花殘天降霜"
    ]
  },
  {
    "no": 67,
    "grade": "上籤",
    "title": "金星試竇兒",
    "poem": [
      "一條金秤等君情",
      "無減無增無重輕",
      "為是平生心正直",
      "文章不識義皆明"
    ]
  },
  {
    "no": 68,
    "grade": "中籤",
    "title": "郭汾陽祝壽",
    "poem": [
      "門庭清吉夢禎祥",
      "積善于門大吉昌",
      "訟理婚成蠶又熟",
      "病逢良藥得安康"
    ]
  },
  {
    "no": 69,
    "grade": "中籤",
    "title": "梅開二度",
    "poem": [
      "冬來嶺上一枝梅",
      "葉落枯枝總不摧",
      "探得陽春消息近",
      "依然還我做花魁"
    ]
  },
  {
    "no": 70,
    "grade": "下籤",
    "title": "李密反唐",
    "poem": [
      "朝朝役役恰如蜂",
      "飛來飛去西復東",
      "春暮花殘無覔處",
      "此身不戀舊叢中"
    ]
  },
  {
    "no": 71,
    "grade": "中籤",
    "title": "文君訪相如",
    "poem": [
      "誰知愛寵遇強徒",
      "女子當年嫁二夫",
      "自是一弓施兩箭",
      "騎龍跨馬上安居"
    ]
  },
  {
    "no": 72,
    "grade": "中籤",
    "title": "王莽求賢",
    "poem": [
      "弄蜂須要求他蜜",
      "只怕遭他尾上針",
      "雖是眼前有異路",
      "暗裏深藏荊棘林"
    ]
  },
  {
    "no": 73,
    "grade": "上籤",
    "title": "陳橋兵變",
    "poem": [
      "春雷震起蟄中蟲",
      "脫卻塵凡出舊墉",
      "忽遇風雲交際處",
      "自然變化得成龍"
    ]
  },
  {
    "no": 74,
    "grade": "下籤",
    "title": "秦敗擒三帥",
    "poem": [
      "慵飛野鶴自投籠",
      "欲舉鵬霄落陷中",
      "南北東西混障碍",
      "此身憔悴恨無窮"
    ]
  },
  {
    "no": 75,
    "grade": "中籤",
    "title": "伍員夜出昭關",
    "poem": [
      "宛如抱虎過山前",
      "戰戰兢兢膽碎寒",
      "幸得山前逢妙手",
      "方能保得一身安"
    ]
  },
  {
    "no": 76,
    "grade": "中籤",
    "title": "洪武看牛",
    "poem": [
      "魚龍混雜意和同",
      "耐守寒潭未濟中",
      "不覺一朝頭角聳",
      "禹門一跳到天宮"
    ]
  },
  {
    "no": 77,
    "grade": "中籤",
    "title": "捧璧歸趙(完璧歸趙)",
    "poem": [
      "夢中說夢獲多財",
      "身外浮名總莫猜",
      "水遠山遙難信定",
      "貴人一指笑顏開"
    ]
  },
  {
    "no": 78,
    "grade": "上籤",
    "title": "臨潼救駕",
    "poem": [
      "冷水來澆白雪洋",
      "不寒不熱自溫涼",
      "要行天下無他事",
      "惟有中藏一藝強"
    ]
  },
  {
    "no": 79,
    "grade": "中籤",
    "title": "暗扶倒銅旗",
    "poem": [
      "虛空結愿結人緣",
      "保得人安愿未還",
      "得兔忘蹄真絕跡",
      "敢將初誓謾輕瞞"
    ]
  },
  {
    "no": 80,
    "grade": "上籤",
    "title": "劉智遠投軍",
    "poem": [
      "直上高山去學仙",
      "豈知一旦帝王宣",
      "青天白日常明照",
      "志在聲名四海傳"
    ]
  },
  {
    "no": 81,
    "grade": "上籤",
    "title": "風送滕王閣（兩版故事皆同）",
    "poem": [
      "庭前葉落暮秋時",
      "行客奔程勢若飛",
      "謝得天公輕着力",
      "順風相送寶船歸"
    ]
  },
  {
    "no": 82,
    "grade": "中籤",
    "title": "火燒葫蘆谷",
    "poem": [
      "炎炎烈火焰燒天",
      "焰裡還生一朵蓮",
      "到底永成根不壞",
      "依然枝葉色新鮮"
    ]
  },
  {
    "no": 83,
    "grade": "中籤",
    "title": "李淵登位",
    "poem": [
      "譬若初三四五蟾",
      "半無半有未完全",
      "須教十五良宵夜",
      "到處清光到處圓"
    ]
  },
  {
    "no": 84,
    "grade": "下籤",
    "title": "莊子試妻",
    "poem": [
      "因名喪德不和同",
      "切忌忙中變作凶",
      "醉後不知何處去",
      "青松影裡睡矇矓"
    ]
  },
  {
    "no": 85,
    "grade": "中籤",
    "title": "韓文公遇雪",
    "poem": [
      "重開山後藏前事",
      "萬寶園中可再團",
      "醉詠新詩添逸興",
      "貴人引接上雲衢"
    ]
  },
  {
    "no": 86,
    "grade": "上籤",
    "title": "商輅中三元",
    "poem": [
      "春來花發映陽臺",
      "萬里舟行進寶來",
      "躍過禹門三級浪",
      "恰如平地一聲雷"
    ]
  },
  {
    "no": 87,
    "grade": "中籤",
    "title": "咬金探地穴",
    "poem": [
      "人行半嶺日啣山",
      "峻險巉巖未可攀",
      "仰望上天垂護佑",
      "此身猶在太虛間"
    ]
  },
  {
    "no": 88,
    "grade": "中籤",
    "title": "龐洪畏包公",
    "poem": [
      "木雕一虎在山林",
      "遠望威容意不禁",
      "縱說不妨終可畏",
      "此身如入大江心"
    ]
  },
  {
    "no": 89,
    "grade": "上籤",
    "title": "大看瑤花(瓊花/曇花)",
    "poem": [
      "出入營謀大吉昌",
      "無瑕玉在石中藏",
      "如今幸得高人指",
      "獲寶從心喜不常"
    ]
  },
  {
    "no": 90,
    "grade": "上籤",
    "title": "葦佩遇仙(韋佩遇仙)",
    "poem": [
      "忽朝一信天下墀",
      "寶貝船裝滿載歸",
      "若問前程成底事",
      "始終應得貴人提"
    ]
  },
  {
    "no": 91,
    "grade": "中籤",
    "title": "三戰呂布",
    "poem": [
      "好把愁眉須展開",
      "大才大用薦將來",
      "一條大路平如掌",
      "凡有施為總稱懷"
    ]
  },
  {
    "no": 92,
    "grade": "上籤",
    "title": "蔡卿報恩(蔡邕)",
    "poem": [
      "經商得利稱心懷",
      "福祿榮華倍獲財",
      "若問進身謀望事",
      "秀才一舉狀元回"
    ]
  },
  {
    "no": 93,
    "grade": "中籤",
    "title": "高君保招親(高俊保)",
    "poem": [
      "鸞鳳翎毛雨壓垂",
      "此時應被雀輕欺",
      "忽朝一日雲霄霽",
      "依舊還教振羽衣"
    ]
  },
  {
    "no": 94,
    "grade": "下籤",
    "title": "伯牙訪友(伯牙碎琴)",
    "poem": [
      "小人君子別賢愚",
      "事有差訛合是非",
      "琴遇知音當鼓操",
      "爭如定靜得便宜"
    ]
  },
  {
    "no": 95,
    "grade": "中籤",
    "title": "曹丕稱帝",
    "poem": [
      "事業功勳暮與朝",
      "榮華物態不勝饒",
      "報君記取金雞鬪",
      "福祿聲名價自超"
    ]
  },
  {
    "no": 96,
    "grade": "上籤",
    "title": "汾陽王七夕天孫（引用唐史演義第63回，『天孫』在此指織女）",
    "poem": [
      "巍巍寶塔不尋常",
      "八面玲瓏盡放光",
      "勸汝志心勤頂禮",
      "天龍擁護降千祥"
    ]
  },
  {
    "no": 97,
    "grade": "中籤",
    "title": "六出祁山",
    "poem": [
      "園林月色搖疎影",
      "恍若鋪成滿地瓊",
      "幾度兒童來收拾",
      "豈知收拾總無成"
    ]
  },
  {
    "no": 98,
    "grade": "下籤",
    "title": "吉平遇難",
    "poem": [
      "經商出入事遲疑",
      "恐惹閒愁與是非",
      "如鳥飛投羅網陷",
      "相看能有幾人知"
    ]
  },
  {
    "no": 99,
    "grade": "下籤",
    "title": "陶三春掛帥",
    "poem": [
      "等閑騎馬着鞭來",
      "半有憂危半有財",
      "似火方燒頭上屋",
      "天教一雨蕩殃災"
    ]
  },
  {
    "no": 100,
    "grade": "下籤",
    "title": "三教談道",
    "poem": [
      "欲就東兮欲就西",
      "逢人說事轉痴迷",
      "登山不見神仙面",
      "莫若歸休更勿提"
    ]
  }
]
